<?xml version="1.0" encoding="utf-8"?>
<!--
  关于页：一屏展示完毕，刻意不使用 ScrollView。
  纵向固定排布 = 品牌区 + 三行信息卡 + 功能说明；内容区 weight=1 吸收多余高度，页脚贴底。
  高度预算：56(toolbar) + 22 + 122(品牌) + 26 + 146(信息卡) + 24 + 20(小标题) + 96(说明卡) + 34(页脚) ≈ 546dp，
  在 720p(≈640dp 可用高) 到 2400px(≈870dp) 的屏幕上都不会溢出。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_glass_page"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#2E7D32"
        android:minHeight="56dp"
        app:navigationIcon="@drawable/ic_back_white"
        app:title="关于"
        app:titleTextColor="#FFFFFF" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="26dp"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/bg_about_logo">

                <ImageView
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:contentDescription="@string/app_name"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_launcher_foreground" />

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:text="@string/app_name"
                android:textColor="#1F2A22"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="版本 1.0.0（构建 10000）"
                android:textColor="#6B7A6E"
                android:textSize="12sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_about_card"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/rowUpdate"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_about_row"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="检查更新"
                    android:textColor="#1F2A22"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvUpdateState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="已是最新"
                    android:textColor="#3E6B47"
                    android:textSize="12sp" />

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginStart="7dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:background="#EDF1EB" />

            <LinearLayout
                android:id="@+id/rowGithub"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_about_row"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="GitHub"
                    android:textColor="#1F2A22"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ASH-C776/minimalnav"
                    android:textColor="#5A6A5E"
                    android:textSize="12sp" />

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginStart="7dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:background="#EDF1EB" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="作者"
                    android:textColor="#1F2A22"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="基耶杰"
                    android:textColor="#5A6A5E"
                    android:textSize="13sp" />

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="8dp"
            android:letterSpacing="0.05"
            android:text="功能说明"
            android:textColor="#6B7A6E"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_about_card"
            android:lineSpacingExtra="5dp"
            android:padding="14dp"
            android:text="把常去的地点存成一条清单。单击直接调起高德地图，开始驾车导航。支持坐标与 POI ID 两种录入方式。"
            android:textColor="#3A463C"
            android:textSize="13sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="10dp"
        android:paddingBottom="12dp"
        android:text="© 2026 基耶杰"
        android:textColor="#9AA69C"
        android:textSize="11sp" />

</LinearLayout>
