<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!--
      右上角两枚纯图标按钮：从左到右「＋ 增加地址」「设置」。
      贴在右上角，与居中的地址列表互不遮挡；顶部避让在代码中按状态栏设置 margin。
    -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginEnd="16dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btnAdd"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_glass_card"
            android:clickable="true"
            android:contentDescription="增加地址"
            android:focusable="true"
            android:padding="14dp"
            android:src="@drawable/ic_add" />

        <Space
            android:layout_width="8dp"
            android:layout_height="match_parent" />

        <ImageView
            android:id="@+id/btnSettings"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_glass_card"
            android:clickable="true"
            android:contentDescription="设置"
            android:focusable="true"
            android:padding="14dp"
            android:src="@drawable/ic_settings" />

    </LinearLayout>

    <!--
      地址列表整体居中：上下 Space 各占一份权重，把中间的 listColumn 顶到屏幕正中。
      内容超高时 Space 自动收缩为 0，列表占满可用高度，不越界。
    -->
    <LinearLayout
        android:id="@+id/centerWrap"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <FrameLayout
            android:id="@+id/listColumn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingTop="6dp"
                android:paddingBottom="6dp" />

            <TextView
                android:id="@+id/tvEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/bg_glass_button"
                android:gravity="center"
                android:padding="16dp"
                android:text="还没有地址\n点右上角 ＋ 添加"
                android:textColor="#1C1C1A"
                android:textSize="16sp"
                android:visibility="gone" />

        </FrameLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>

    <!--
      浮层按需膨胀：绝大多数冷启动用户不会打开菜单，没必要为一个隐藏的覆盖层
      付出 3 个容器的膨胀与 drawable 解析成本。首次点「设置」或长按时才 inflate。
    -->
    <ViewStub
        android:id="@+id/sheetStub"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout="@layout/sheet_actions" />

</FrameLayout>
